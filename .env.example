# Bu dosyayı .env olarak kopyalayın ve değerleri ortamınıza göre doldurun.
# .env yoksa proje sqlite + InMemory channel layer ile yerel geliştirme
# varsayılanlarına döner (cafe/settings.py). docker-compose.yml bu dosyayı
# hem Postgres container'ını hem de web/worker servislerini ayarlamak için
# okur.

# --- Django --------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CORS_ALLOW_ALL_ORIGINS=False
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com

# --- Postgres (docker-compose "db" servisine ve web/worker'a aktarılır) --
POSTGRES_DB=cafe
POSTGRES_USER=cafe
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (docker-compose "redis" servisi) -------------------------------
DJANGO_REDIS_URL=redis://redis:6379/0
DJANGO_CELERY_BROKER_URL=redis://redis:6379/15
